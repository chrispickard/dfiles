[
  {
    "defaults": {
      "relink": true,
      "create": true
    },
    "clean": [
        "~",
        "~/.config"
    ],
    "link": {
      "~/.config/tmux": {
        "path": "config/tmux"
      },
      "~/.config/tmuxp": {
        "path": "config/tmuxp"
      },
      "~/.config/doom": {
        "path": "config/doom"
      },
      "~/.config/jj/config.toml": {
        "path": "config/jj/config.toml"
      },
      "~/.config/foot": {
        "path": "config/foot"
      },
      "~/.config/run-or-raise": {
        "path": "config/run-or-raise"
      },
      "~/bin/tbg": {
        "path": "bin/tbg"
      },
      "~/bin/render-template": {
        "path": "bin/render-template"
      },
      "~/bin/janitor": {
        "path": "bin/janitor"
      },
      "~/bin/e": {
        "path": "bin/e"
      },
      "~/bin/et": {
        "path": "bin/et"
      },
      "~/.ideavimrc": {
        "path": "config/ideavimrc"
      }
    }
  }
]
