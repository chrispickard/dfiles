[
  {
    "defaults": {
      "relink": true,
      "create": true
    },
    "clean": [
        "~",
        "~/.config"
    ],
    "link": {
      "~/.config/tmux": {
        "path": "config/tmux"
      },
      "~/.config/tmuxp": {
        "path": "config/tmuxp"
      },
      "~/.config/doom": {
        "path": "config/doom"
      },
      "~/.config/Code/User/settings.json": {
        "path": "config/code/settings.json"
      },
      "~/.config/Code/User/keybindings.json": {
        "path": "config/code/keybindings.json"
      },
      "~/.config/fish": {
        "path": "config/fish"
      },
      "~/.config/jj/config.toml": {
        "path": "config/jj/config.toml"
      },
      "~/.config/git": {
        "path": "config/git"
      },
      "~/.config/foot": {
        "path": "config/foot"
      },
      "~/.config/run-or-raise": {
        "path": "config/run-or-raise"
      },
      "~/bin/tbg": {
        "path": "bin/tbg"
      },
      "~/bin/render-template": {
        "path": "bin/render-template"
      },
      "~/bin/jj-fetch-pr": {
        "path": "bin/jj-fetch-pr"
      },
      "~/bin/janitor": {
        "path": "bin/janitor"
      },
      "~/bin/e": {
        "path": "bin/e"
      },
      "~/bin/et": {
        "path": "bin/et"
      },
      "~/.ideavimrc": {
        "path": "config/ideavimrc"
      }
    }
  }
]
